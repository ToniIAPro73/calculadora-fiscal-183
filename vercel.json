{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/openapi.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/es",
      "destination": "/",
      "statusCode": 308
    },
    {
      "source": "/es/legal-notice",
      "destination": "/es/legal",
      "statusCode": 301
    },
    {
      "source": "/en/legal-notice",
      "destination": "/en/legal",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/en",
      "destination": "/en/index.html"
    },
    {
      "source": "/es/terms",
      "destination": "/es/terms/index.html"
    },
    {
      "source": "/es/privacy",
      "destination": "/es/privacy/index.html"
    },
    {
      "source": "/es/legal",
      "destination": "/es/legal/index.html"
    },
    {
      "source": "/es/cookies",
      "destination": "/es/cookies/index.html"
    },
    {
      "source": "/es/guide",
      "destination": "/es/guide/index.html"
    },
    {
      "source": "/es/guide/digital-nomad-visa-183-days",
      "destination": "/es/guide/digital-nomad-visa-183-days/index.html"
    },
    {
      "source": "/es/guide/beckham-law-vs-183-days",
      "destination": "/es/guide/beckham-law-vs-183-days/index.html"
    },
    {
      "source": "/es/guide/counting-days-arrival-departure",
      "destination": "/es/guide/counting-days-arrival-departure/index.html"
    },
    {
      "source": "/es/guide/sporadic-absences-tax-treaties",
      "destination": "/es/guide/sporadic-absences-tax-treaties/index.html"
    },
    {
      "source": "/es/about",
      "destination": "/es/about/index.html"
    },
    {
      "source": "/es/irpf-estimator",
      "destination": "/es/irpf-estimator/index.html"
    },
    {
      "source": "/es/premium-report",
      "destination": "/es/premium-report/index.html"
    },
    {
      "source": "/en/terms",
      "destination": "/en/terms/index.html"
    },
    {
      "source": "/en/privacy",
      "destination": "/en/privacy/index.html"
    },
    {
      "source": "/en/legal",
      "destination": "/en/legal/index.html"
    },
    {
      "source": "/en/cookies",
      "destination": "/en/cookies/index.html"
    },
    {
      "source": "/en/guide",
      "destination": "/en/guide/index.html"
    },
    {
      "source": "/en/guide/digital-nomad-visa-183-days",
      "destination": "/en/guide/digital-nomad-visa-183-days/index.html"
    },
    {
      "source": "/en/guide/beckham-law-vs-183-days",
      "destination": "/en/guide/beckham-law-vs-183-days/index.html"
    },
    {
      "source": "/en/guide/counting-days-arrival-departure",
      "destination": "/en/guide/counting-days-arrival-departure/index.html"
    },
    {
      "source": "/en/guide/sporadic-absences-tax-treaties",
      "destination": "/en/guide/sporadic-absences-tax-treaties/index.html"
    },
    {
      "source": "/en/about",
      "destination": "/en/about/index.html"
    },
    {
      "source": "/en/irpf-estimator",
      "destination": "/en/irpf-estimator/index.html"
    },
    {
      "source": "/en/premium-report",
      "destination": "/en/premium-report/index.html"
    },
    {
      "source": "/es/payment-success",
      "destination": "/index.html"
    },
    {
      "source": "/es/payment-mock",
      "destination": "/index.html"
    },
    {
      "source": "/en/payment-success",
      "destination": "/index.html"
    },
    {
      "source": "/en/payment-mock",
      "destination": "/index.html"
    },
    {
      "source": "/es/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|assets/|@|.*\\..*$).*)",
      "destination": "/index.html"
    }
  ]
}
