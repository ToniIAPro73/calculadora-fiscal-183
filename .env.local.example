# ============================================
# Variables privadas del backend / serverless
# No deben exponerse al frontend
# ============================================

# Stripe privado
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
STRIPE_PRICE_ID=price_xxxxx
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ============================================
# Variables públicas del frontend (Vite)
# Se exponen al cliente y deben ser seguras
# ============================================

# Stripe público
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
VITE_CURRENCY=EUR

# Analytics / Ads
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_GOOGLE_ADS_CONVERSION_ID=AW-XXXXXXXXXX
VITE_GOOGLE_ADS_CONVERSION_LABEL=XXXXXXXXXXXXXXX

# ============================================
# Informe para asesores/despachos (Mejora 15)
# ============================================

# Price de Stripe para el informe de asesor (privado, lo usa el backend).
# Crear antes el Price en el dashboard de Stripe (producto "Informe asesor")
# y pegar aquí su ID. El backend solo lo usa cuando el checkout llega con
# advisor=true; si falta, ese checkout devuelve 500 y el estándar sigue igual.
STRIPE_ADVISOR_PRICE_ID=

# Flag maestra del frontend: con cualquier valor distinto de "true", la opción
# "Soy asesor/despacho" del modal de pago se muestra DESHABILITADA ("Próximamente").
VITE_ADVISOR_ENABLED=false

# ID del Price de asesor creado en Stripe (debe coincidir con
# STRIPE_ADVISOR_PRICE_ID). El frontend lo usa solo como señal de que el Price
# existe: sin este valor, la opción queda visible pero deshabilitada.
# Nunca se envía al backend: el precio real lo resuelve el servidor.
VITE_ADVISOR_PRICE_ID=
